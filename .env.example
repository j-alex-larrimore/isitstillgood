# Copy this file to .env and fill in values from Railway's Variables tab
# (Project → isitstillgood service → Variables).
#
# See CLAUDE.md "Environment variables" section for full details.

# Required — public Postgres connection string. Without this, nothing runs.
# NOTE: this points at production data — scripts run locally write directly
# to it, be careful.
DATABASE_URL=

# Optional — only needed for scripts/bulk-import.js to do real (non-dry-run)
# lookups instead of skipping them. Copy from Railway.
TMDB_READ_ACCESS_TOKEN=
GOOGLE_BOOKS_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Optional — only needed for scripts/sync-new-books.js. NOT set in Railway
# (the app itself doesn't use it) — get a free key from
# developer.nytimes.com (Apps → New App → enable Books API).
NYT_API_KEY=
