generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaType {
  MOVIE
  BOOK
  TV_SHOW
  VIDEO_GAME
}

enum ReviewVisibility {
  PUBLIC
  FRIENDS_ONLY
  PRIVATE
}

enum FriendStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model MediaItem {
  id              String     @id @default(cuid())
  mediaType       MediaType
  title           String
  // Lowercased, punctuation-stripped copy of title, kept in sync at write
  // time (see normalizeTitleForSearch in src/lib/mediaHelpers.js) so search
  // can match "la confidential" against "L.A. Confidential" without a
  // per-query, unindexed string scan across the whole table.
  normalizedTitle String?
  slug            String     @unique
  releaseYear     Int?
  description     String?    @db.Text
  imageUrl        String?
  genres          String[]
  tags            String[]  // freeform tags e.g. Marvel, Star Wars, HBO, Disney
  excludedCast    String[]  // names of cast members excluded from this season (departed actors)

  // Review gate for automated/bulk-added items (scripts/bulk-import.js, the
  // admin bulk-import route). Defaults to true so existing items and items
  // added one at a time through the admin form (already reviewed by a human
  // as they filled the form) stay visible immediately. Bulk-creation paths
  // explicitly set this to false so new items queue for admin approval
  // before showing up in public browse/search/feed/sitemap.
  verified        Boolean    @default(true)

  // External ratings — IMDb and RT removed (licensing concerns)
  // Community ratings stored here, fetched via TMDB, Open Library, IGDB
  tmdbId          String?   // TMDB movie/show ID
  tmdbRating      Float?    // TMDB community rating (0-10)
  goodreadsId     String?   // Open Library / Goodreads ID for books
  openCriticId    String?   // IGDB ID for games (repurposed field)
  openCriticScore Int?      // IGDB rating for games (repurposed field)
  externalRatingsUpdatedAt DateTime?

  // Where to watch — movies and TV parent rows only (see
  // scripts/sync-streaming-providers.js), US region, sourced from JustWatch
  // via TMDB's watch/providers endpoint. Shape:
  // { link, flatrate: [{id,name,logoPath}], rent: [...], buy: [...] }
  // TMDB's terms require attributing JustWatch as the source wherever this
  // is displayed (see item.html) — don't drop that attribution.
  streamingProviders   Json?
  streamingUpdatedAt   DateTime?

  // Movie-specific
  directors       Person[]   @relation("DirectedBy")
  cast            Person[]   @relation("AppearedIn")
  // Person ids from `cast` above, in billing order. Necessary because `cast`
  // is an implicit many-to-many relation — Prisma gives implicit M2M no
  // extra columns to carry a per-relation order on, and Postgres doesn't
  // guarantee row order for a SELECT without ORDER BY, so retrieval order
  // was effectively undefined once connected (confirmed: multiple read
  // sites were papering over this with an explicit alphabetical-by-name
  // sort — see media.js's GET /:slug and admin.js — which is what actually
  // produced the "random-looking" order relative to real billing).
  // Written by connectCast() (src/lib/mediaHelpers.js) whenever cast is
  // set, sourced from TMDB's already-billing-ordered credits.cast. Empty
  // for any item added before this field existed — read sites fall back to
  // the old alphabetical sort when castOrder is empty, not to Postgres's
  // undefined native order.
  castOrder       String[]   @default([])

  // TV Show-specific
  // parentId links a season entry back to its parent show MediaItem.
  // A parent show row has parentId = null and seasons = total count.
  // Each season row has parentId = show's id and seasonNumber = which season.
  parentId        String?
  parent          MediaItem?  @relation("ShowSeasons", fields: [parentId], references: [id])
  seasonEntries   MediaItem[] @relation("ShowSeasons")  // reverse — all seasons of this show
  seasonNumber    Int?        // which season this entry represents (1, 2, 3…)
  seasons         Int?        // total season count — stored on the parent show row only

  // Book-specific
  authors         Person[]   @relation("AuthoredBy")
  seriesName      String?    // e.g. "The Dark Tower"
  seriesNumber    Float?     // e.g. 3, or 2.5 for an interstitial/companion volume
  // ISBN-13, digits only, no hyphens. Exists so a Goodreads export can be
  // matched exactly instead of by title+author — goodreadsId is no help
  // there, since despite the name it holds a mix of Open Library work ids
  // and Google Books volume ids and never an ISBN.
  //
  // Deliberately NOT unique: the same work legitimately appears more than
  // once (editions, a series parent and its volumes), so this is a lookup
  // key, not an identity. ISBN-10s are converted to their 13 form on the way
  // in rather than stored separately, since that conversion is lossless and
  // one column means one index and one query.
  isbn13          String?

  // EVERY ISBN-13 known for this work, across all its editions — the one to
  // match an import against. `isbn13` above is the canonical single value kept
  // for display and for anything that wants one id; this is the lookup set.
  //
  // It exists because one ISBN per book makes importing almost useless. A
  // Goodreads or StoryGraph export carries the ISBN of the *edition that
  // reader shelved*, and a work has many: Jurassic Park has 94 editions and 73
  // distinct ISBN-13s. Matching one stored value against one shelved value is
  // roughly a 1-in-73 shot on that book, so raising single-ISBN coverage would
  // not have fixed matching — only holding the whole set does.
  //
  // Populated from Open Library's /works/{id}/editions.json (free, unmetered)
  // by scripts/backfill-book-isbns.js, which always unions in isbn13 so the
  // canonical value can never be lost. Digits only, no hyphens, ISBN-10s
  // converted to their 13 form on the way in — same normalization as isbn13,
  // so a caller can check both with one comparison.
  //
  // GIN indexed because every read is a set-overlap (`hasSome`), never an
  // equality test. A btree would be useless here.
  isbns           String[]

  // Movie / TV-show identifier only — the `tt…` id, e.g. "tt0111161".
  //
  // This is NOT a step back toward storing IMDb ratings; those stay removed
  // for the licensing reasons noted at tmdbId above, and nothing here fetches
  // anything from IMDb. It exists so that a ratings CSV a user exported from
  // their own IMDb account can be matched on an exact key instead of by
  // title+year, which is the one part of the Letterboxd importer that
  // occasionally attaches a rating to the wrong film.
  //
  // Sourced from TMDB's own `imdb_id` / `external_ids` fields, which this
  // project is already licensed to read — see scripts/backfill-imdb-ids.js.
  // Set on movies and on TV *parent* rows (parentId: null) only: IMDb rates a
  // show as a whole, so a season row has no IMDb id of its own.
  //
  // Not unique, for the same reason isbn13 isn't — a lookup key, not identity.
  imdbId          String?

  // Video game-specific
  openCriticId2   String?    // kept for compat, use openCriticId

  // Review is per season for TV shows
  // seasonNumber stored on Review model

  reviews         Review[]
  listItems       ListItem[]
  pendingImports  PendingImport[]

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([mediaType])
  @@index([title])
  @@index([normalizedTitle])
  @@index([releaseYear])
  @@index([verified])
  @@index([isbn13])
  @@index([imdbId])
  @@index([isbns], type: Gin)
}

model Person {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  imageUrl    String?
  bio         String?     @db.Text
  birthYear   Int?
  directed    MediaItem[] @relation("DirectedBy")
  appeared    MediaItem[] @relation("AppearedIn")
  authored    MediaItem[] @relation("AuthoredBy")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  @@index([name])
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  username        String    @unique
  displayName     String
  bio             String?
  avatarUrl       String?
  // A user-picked emoji shown on the public feed (index.html) instead of
  // the plain two-letter username initials — see FEED_AVATAR_ICONS in
  // src/routes/users.js, the curated set this is validated against.
  // Deliberately independent of avatarUrl (Google's real profile photo,
  // never shown on the feed itself — see index.html's renderReviewCard):
  // the feed intentionally shows usernames rather than real identity, and a
  // real photo would undercut that the same way a real name would.
  avatarEmoji     String?
  // Email notification preferences, both opt-out (see the Email Preferences
  // modal in profile.html). The in-app notification bell isn't a sufficient
  // nudge on its own for either of these — it's only seen by someone already
  // on the site, which is exactly who doesn't need telling.
  //   emailOnMessage       — sendNewMessageEmail, from POST /api/messages
  //   emailOnFriendRequest — sendFriendRequestEmail / sendFriendAcceptedEmail,
  //                          from POST /api/friends/request/:userId and
  //                          POST /api/friends/accept/:friendshipId. One
  //                          toggle covers both halves of the exchange:
  //                          they're the same conversation, and wanting one
  //                          without the other isn't a real preference.
  emailOnMessage       Boolean @default(true)
  emailOnFriendRequest Boolean @default(true)
  isVerified      Boolean   @default(false)
  isAdmin         Boolean   @default(false)
  passwordHash    String?
  googleId        String?   @unique
  googleEmail     String?
  defaultVisibility ReviewVisibility @default(PUBLIC)
  // Public by default: a friends-only default made the lock screen the normal
  // result of clicking any user you weren't already friends with, which is a
  // dead end on a site whose point is reading other people's reviews. Note a
  // default only governs NEW rows — existing accounts keep whatever they have.
  profilePublic   Boolean   @default(true)
  tasteThreshold  Int       @default(2)
  ignoredGenres   String[]  @default([])  // false = friends only, true = public
  // Emails (not usernames) — a username can now be changed by its owner
  // (see PATCH /api/users/me/settings), and a stored username would go
  // stale silently on rename since nothing here points back at a user id.
  excludedFriends String[]  @default([])  // emails excluded from friend rating filters
  consumedWithin  String?                 // e.g. "12m" or "2y" — default recency filter

  // Self-service account cancellation (soft — distinct from the admin
  // spam-purge hard delete). When set: login is blocked (passwordHash/googleId
  // are cleared at cancellation time), the profile page 404s, and all of this
  // user's reviews have reviewText/spoilerText cleared while rating/verdict
  // stay intact so aggregate scores don't shift. The User row itself and its
  // Review rows are kept — only the written content is removed.
  canceledAt      DateTime?
  reviews         Review[]
  reactions       Reaction[]
  comments        Comment[]
  friendsInitiated  Friendship[] @relation("FriendInitiator")
  friendsReceived   Friendship[] @relation("FriendReceiver")
  lists           MediaList[]
  notifications   Notification[]
  mediaRequests   MediaRequest[]
  refreshTokens   RefreshToken[]
  sentInvites     InviteToken[]    // invitations this user has sent
  sentMessages    Message[] @relation("MessageSender")
  receivedMessages Message[] @relation("MessageRecipient")
  sentListShares     ListShare[] @relation("ListShareSender")
  receivedListShares ListShare[] @relation("ListShareRecipient")
  emailVerificationTokens EmailVerificationToken[]
  pendingImports  PendingImport[]
  badges          UserBadge[]
  importEvents    ImportEvent[]

  // ─── Where this account came from ──────────────────────────────────────
  // Captured first-touch in the browser by analytics.js and sent once, right
  // after the account is created. Written only while still empty, so it
  // records the visit that started the relationship rather than the most
  // recent one.
  //
  // This exists because the ad platforms' own dashboards were the only other
  // answer, and when one of them shows nothing there is no way to tell a
  // reporting problem from a delivery problem. A signup should be able to say
  // where it came from without having to ask Reddit.
  attrSource        String?   // utm_source, or 'direct' when the visit carried nothing
  attrMedium        String?
  attrCampaign      String?
  attrContent       String?
  attrTerm          String?
  attrRedditClickId String?   // rdt_cid — what Reddit matches a conversion on
  attrMetaClickId   String?   // fbclid
  attrReferrer      String?   // all an organic visit has to go on
  attrLandedOn      String?   // the path that first visit started on
  attrLandedAt      DateTime? // when it happened, which can long predate signup
  attrCapturedAt    DateTime? // when this was recorded; also the "already set" flag
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@index([email])
  @@index([username])
  @@index([attrSource])
  @@index([attrCampaign])
}

// ─── EMAIL VERIFICATION TOKENS ─────────────────────────────────────────────
// Backs two flows: confirming a new registration's email (newEmail: null —
// the token just flips isVerified on the account it belongs to) and
// confirming an email-address change (newEmail set — clicking the link
// swaps User.email to newEmail). One-time use — consumed/deleted on click.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique @default(cuid())
  newEmail  String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([token])
  @@index([userId])
}

model RefreshToken {
  id          String   @id @default(cuid())
  token       String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model Friendship {
  id          String       @id @default(cuid())
  initiatorId String
  receiverId  String
  status      FriendStatus @default(PENDING)
  initiator   User @relation("FriendInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  receiver    User @relation("FriendReceiver",  fields: [receiverId],  references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([initiatorId, receiverId])
  @@index([receiverId])
  @@index([status])
}

model Review {
  id            String           @id @default(cuid())
  userId        String
  mediaItemId   String
  rating        Int
  dateConsumed  DateTime?        // When the user last read/watched/played this — optional
  seasonNumber  Int?             // TV shows only — null means overall series rating
  isRevisit     Boolean          @default(false)
  previousRating Int?
  reviewText    String?          @db.Text
  spoilerText   String?          @db.Text
  verdict       String?
  visibility    ReviewVisibility @default(PUBLIC)
  // An unpublished, work-in-progress review. Hidden from every read that goes
  // through src/lib/prisma.js, which injects isDraft:false into review queries
  // rather than relying on ~40 call sites to remember. Occupies the same
  // user+item+season slot as a published review would, so an item has either a
  // draft or a live review, never both.
  isDraft       Boolean          @default(false)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaItem     MediaItem  @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  reactions     Reaction[]
  comments      Comment[]
  messages      Message[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  // Unique per user + media item + season (null season = overall)
  // Two separate facts about when this review showed up, both decided once at
  // write time and never recomputed: being early is a fact about when someone
  // turned up, and deleting a later review should not retroactively hand the
  // credit to somebody else.
  //
  // isFirstReview is the stronger claim and is kept distinct because "first
  // review of this title" is worth saying on a card in a way that "one of the
  // first ten" is not. isEarlyReview is what the Pathfinder badge counts.
  isFirstReview Boolean @default(false)
  isEarlyReview Boolean @default(false)

  // Written by an importer rather than typed here. The opinion is just as
  // real — it counts toward ratings, badges, the profile and the taste
  // profile — but it is not an *event*. Somebody transferring ten years of
  // Letterboxd history did not watch 900 films this afternoon, and a feed
  // that says they did buries everyone else.
  //
  // src/routes/imports.js already refuses to notify friends about these, for
  // exactly this reason ("an import is one event about a person, not N events
  // about N films"); the feed simply never applied the same rule. Set on
  // creation only — an import that updates a review somebody wrote by hand
  // must not retroactively hide their own writing from the feed.
  isImported    Boolean @default(false)

  // Chosen by the reviewer, where isImported above is a fact about origin.
  // Both keep a review out of the activity feed, but they are not the same
  // thing and must not be merged: an import can later be unhidden and still
  // be an import.
  //
  // This is NOT visibility. A PRIVATE review is hidden from everyone
  // everywhere. A hidden one is fully public — it still counts toward the
  // title's score and still appears on the title's own page — it just is not
  // broadcast. The case is reviewing something obscure, or something bad,
  // without pushing it at every friend you have.
  hiddenFromFeed    Boolean @default(false)
  // Goes further: also kept off the author's public profile list. Still on
  // the title's page, still counted. Implies hiddenFromFeed — the API
  // enforces that, since being absent from a profile but present in the feed
  // would be incoherent. The owner always sees their own, marked as hidden,
  // or they could never find it again to change it back.
  hiddenFromProfile Boolean @default(false)

  @@unique([userId, mediaItemId, seasonNumber])
  @@index([userId])
  @@index([mediaItemId])
  @@index([visibility])
  @@index([createdAt])
  // Fetching a user's own drafts is the one hot path that filters on isDraft.
  @@index([userId, isDraft])
}

model Reaction {
  id        String   @id @default(cuid())
  userId    String
  reviewId  String
  emoji     String   @default("❤️")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, reviewId, emoji])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  reviewId  String
  body      String   @db.Text
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment? @relation("Replies", fields: [parentId], references: [id])
  replies   Comment[] @relation("Replies")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([reviewId])
}

model MediaList {
  id          String     @id @default(cuid())
  userId      String
  title       String
  description String?
  isPublic    Boolean    @default(true)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       ListItem[]
  shares      ListShare[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model ListItem {
  id          String    @id @default(cuid())
  listId      String
  mediaItemId String
  note        String?
  position    Int       @default(0)
  list        MediaList @relation(fields: [listId], references: [id], onDelete: Cascade)
  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id])
  addedAt     DateTime  @default(now())
  @@unique([listId, mediaItemId])
}

// A list actively sent to a specific friend ("Alex recommends this list to
// you") — distinct from MediaList.isPublic, which controls passive
// visibility (anyone vs. friends-only) rather than targeting one person.
// Sharing again with the same recipient is a no-op (@@unique below) rather
// than a duplicate notification.
model ListShare {
  id          String    @id @default(cuid())
  listId      String
  list        MediaList @relation(fields: [listId], references: [id], onDelete: Cascade)
  sharedById  String
  sharedBy    User      @relation("ListShareSender",    fields: [sharedById],  references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("ListShareRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  @@unique([listId, recipientId])
  @@index([recipientId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  payload   Json
  read      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId, read])
}

model MediaRequest {
  id               String    @id @default(cuid())
  userId           String
  title            String
  mediaType        MediaType
  directorOrAuthor String?
  notes            String?
  requestCount     Int       @default(1)
  flagged          Boolean   @default(false)
  flagNote         String?
  resolved         Boolean   @default(false)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  @@index([mediaType])
  @@index([requestCount])
  @@index([resolved])
}

model AdminSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─── INVITE TOKENS ────────────────────────────────────────────────────────
// Stores pending email invitations. When someone clicks the link in the email,
// we look up this token to know who invited them and auto-connect as friends.
model InviteToken {
  id          String   @id @default(cuid())
  
  // The user who sent the invite
  inviterId   String
  inviter     User     @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  
  // The email address this invite was sent to — null for a generic link
  // shared directly via text/Instagram/Facebook/etc. rather than emailed to
  // a specific address (see the "Share via..." button on friends.html)
  email       String?
  
  // Unique token embedded in the invite link — expires after 7 days
  token       String   @unique @default(cuid())
  
  // Whether this invite has been used (claimed) already
  claimed     Boolean  @default(false)
  
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  
  @@index([token])   // fast lookup when someone clicks the invite link
  @@index([email])   // check if an email already has a pending invite
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  body        String   @db.Text
  read        Boolean  @default(false)
  // Optional context — if sent in response to a review
  reviewId    String?
  review      Review?  @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  sender      User     @relation("MessageSender",    fields: [senderId],    references: [id], onDelete: Cascade)
  recipient   User     @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  @@index([recipientId, read])
  @@index([senderId])
  @@index([recipientId, senderId])
}

// Short codes for Share-a-Snapshot links (browse.html/profile.html) —
// POST /api/share-links mints one from a full path+query, GET
// /api/share-links/:code resolves it back. Exists purely so a shared link
// reads as a short code instead of the full filter state spelled out in
// the query string (type, several filter chips, reviewedBy, recency, etc.
// all at once can run long). No expiry — the underlying filtered view
// doesn't go stale the way e.g. an invite token would.
model ShareLink {
  code      String   @id
  path      String   @db.Text
  createdAt DateTime @default(now())
}

// ─── Imported ratings with nowhere to go yet ─────────────────────────────────
//
// An import used to drop every row it could not match. The reader had already
// done the work of exporting their library, and the only thing standing between
// them and their rating was a title this catalogue did not happen to hold yet —
// so the rating was discarded and they were told, accurately and uselessly,
// that it was not in the catalogue.
//
// These rows keep it instead. A scheduled pass looks each one up against the
// same providers the admin UI uses, adds what it finds, writes the review, and
// tells the reader it happened. Nothing here is shown publicly: until it
// resolves, a PendingImport is a note about a rating, not a rating.
enum ImportSource {
  LETTERBOXD
  GOODREADS
  IMDB
}

enum PendingImportStatus {
  PENDING       // still looking for the title
  RESOLVED      // the review has been written
  CONFLICT      // the title exists now, but a review is already here and disagrees
  UNRESOLVABLE  // looked for it enough times; a human would have to add it
  DISMISSED     // the reader said to drop it
}

model PendingImport {
  id           String   @id @default(cuid())
  userId       String
  source       ImportSource
  mediaType    MediaType

  // What the export said, which is all we have to search with — and all we can
  // show the reader when asking them about it months later.
  title        String
  year         Int?
  author       String?
  isbn         String?
  imdbId       String?

  // The identity this row was deduped on, so re-importing the same library does
  // not stack up copies of the same waiting rating.
  externalKey  String

  rating       Int
  reviewText   String?  @db.Text
  dateConsumed DateTime?
  visibility   ReviewVisibility @default(PUBLIC)

  status       PendingImportStatus @default(PENDING)
  // Lookups cost provider quota, so a row that keeps missing is retried less
  // often and eventually left alone rather than searched for forever.
  attempts     Int      @default(0)
  lastTriedAt  DateTime?
  resolvedAt   DateTime?
  // Set once the title exists, whether the review was written or is waiting on
  // the reader to settle a conflict.
  mediaItemId  String?
  reviewId     String?
  // The rating and words already here, captured when the conflict was found, so
  // the question still makes sense if the reader answers it a week later.
  conflictRating     Int?
  conflictReviewText String?  @db.Text

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaItem    MediaItem? @relation(fields: [mediaItemId], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, source, externalKey])
  @@index([status, lastTriedAt])
  @@index([userId, status])
}

// ─── Badges ──────────────────────────────────────────────────────────────────
//
// Recognition for the people writing reviews before there is any reason to.
// A catalogue of 70,719 titles carrying 1,064 reviews does not look like a
// quiet room to a new visitor, it looks like an empty one — and the people
// fixing that are doing it with nothing in return. This is the something.
//
// Definitions, thresholds and labels live in src/lib/badges.js, not here: a
// badge is a product decision that will be tuned often, and nothing about
// adding one should require a migration. This table only records that a given
// user has earned a given code.
model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  // Matches a key in src/lib/badges.js. Stored as a string rather than an enum
  // precisely so a new badge is a code change and not a schema change.
  code     String
  // For tiered badges (Critic I/II/III) the row is updated in place rather
  // than duplicated, so a user has one Critic badge whose tier climbs.
  tier     Int?
  // Pioneer is numbered — #7 means something #92 does not, and the number has
  // to survive even if an earlier pioneer later deletes their reviews.
  number   Int?
  earnedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([userId])
  @@index([code])
}

// ─── An import, as one thing that happened ───────────────────────────────────
//
// The counterpart to Review.isImported. Hiding 900 imported ratings from the
// feed stops them burying everyone else, but it also means somebody who just
// brought a decade of history across appears to have done nothing at all.
// This is the one entry that says they did.
//
// Recorded as its own event rather than derived from the reviews, because the
// reviews cannot answer it: there is no column saying which import a row came
// from, and inferring it from timestamps is the guesswork that
// scripts/mark-imported-reviews.js has to do for old data precisely because
// this did not exist.
model ImportEvent {
  id        String       @id @default(cuid())
  userId    String
  source    ImportSource
  // Split, because they are different claims: `created` is new opinions,
  // `updated` is ones already here that the import changed, and `pending` is
  // ratings held for titles the catalogue does not have yet.
  created   Int          @default(0)
  updated   Int          @default(0)
  pending   Int          @default(0)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ─── Who actually showed up ──────────────────────────────────────────────────
//
// 311 ad clicks produced no signups and no way to find out why: attribution is
// only written when somebody registers, so a visitor who leaves is invisible.
// The only other source was the ad platform's own numbers, which is exactly the
// thing that needed checking.
//
// Deliberately stores nothing that identifies a person:
//
//   no IP address        not stored, not hashed, not derived from
//   no user agent        only a coarse device bucket and a bot flag
//   no full referrer     only the host, so "google.com" not the query someone
//                        searched for
//   no account link      a signed-in visitor is recorded exactly like anyone
//                        else; this answers "how many people", never "which
//                        person"
//
// sessionId is a random value the browser generates per tab and forgets when
// the tab closes. It exists only to tell six pages viewed by one person from
// six people viewing one page each, and it is omitted entirely when the
// visitor has not consented to storage — those rows still count as views.
model VisitLog {
  id           String   @id @default(cuid())
  path         String
  // Campaign parameters exactly as the URL carried them.
  source       String?
  medium       String?
  campaign     String?
  content      String?
  // The ad networks' click identifiers. Kept because counting distinct values
  // is the only honest way to check a platform's click number against arrivals
  // — it identifies a click, not a person.
  clickId      String?
  clickNetwork String?  // reddit | meta
  referrerHost String?
  country      String?  // two-letter, from Cloudflare's edge header
  device       String?  // mobile | tablet | desktop
  bot          Boolean  @default(false)
  sessionId    String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([source])
  @@index([sessionId])
  @@index([bot, createdAt])
}
