generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaType {
  MOVIE
  BOOK
  TV_SHOW
  VIDEO_GAME
}

enum ReviewVisibility {
  PUBLIC
  FRIENDS_ONLY
  PRIVATE
}

enum FriendStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model MediaItem {
  id              String     @id @default(cuid())
  mediaType       MediaType
  title           String
  // Lowercased, punctuation-stripped copy of title, kept in sync at write
  // time (see normalizeTitleForSearch in src/lib/mediaHelpers.js) so search
  // can match "la confidential" against "L.A. Confidential" without a
  // per-query, unindexed string scan across the whole table.
  normalizedTitle String?
  slug            String     @unique
  releaseYear     Int?
  description     String?    @db.Text
  imageUrl        String?
  genres          String[]
  tags            String[]  // freeform tags e.g. Marvel, Star Wars, HBO, Disney
  excludedCast    String[]  // names of cast members excluded from this season (departed actors)

  // Review gate for automated/bulk-added items (scripts/bulk-import.js, the
  // admin bulk-import route). Defaults to true so existing items and items
  // added one at a time through the admin form (already reviewed by a human
  // as they filled the form) stay visible immediately. Bulk-creation paths
  // explicitly set this to false so new items queue for admin approval
  // before showing up in public browse/search/feed/sitemap.
  verified        Boolean    @default(true)

  // External ratings — IMDb and RT removed (licensing concerns)
  // Community ratings stored here, fetched via TMDB, Open Library, IGDB
  tmdbId          String?   // TMDB movie/show ID
  tmdbRating      Float?    // TMDB community rating (0-10)
  goodreadsId     String?   // Open Library / Goodreads ID for books
  openCriticId    String?   // IGDB ID for games (repurposed field)
  openCriticScore Int?      // IGDB rating for games (repurposed field)
  externalRatingsUpdatedAt DateTime?

  // Where to watch — movies and TV parent rows only (see
  // scripts/sync-streaming-providers.js), US region, sourced from JustWatch
  // via TMDB's watch/providers endpoint. Shape:
  // { link, flatrate: [{id,name,logoPath}], rent: [...], buy: [...] }
  // TMDB's terms require attributing JustWatch as the source wherever this
  // is displayed (see item.html) — don't drop that attribution.
  streamingProviders   Json?
  streamingUpdatedAt   DateTime?

  // Movie-specific
  directors       Person[]   @relation("DirectedBy")
  cast            Person[]   @relation("AppearedIn")

  // TV Show-specific
  // parentId links a season entry back to its parent show MediaItem.
  // A parent show row has parentId = null and seasons = total count.
  // Each season row has parentId = show's id and seasonNumber = which season.
  parentId        String?
  parent          MediaItem?  @relation("ShowSeasons", fields: [parentId], references: [id])
  seasonEntries   MediaItem[] @relation("ShowSeasons")  // reverse — all seasons of this show
  seasonNumber    Int?        // which season this entry represents (1, 2, 3…)
  seasons         Int?        // total season count — stored on the parent show row only

  // Book-specific
  authors         Person[]   @relation("AuthoredBy")
  seriesName      String?    // e.g. "The Dark Tower"
  seriesNumber    Float?     // e.g. 3, or 2.5 for an interstitial/companion volume

  // Video game-specific
  openCriticId2   String?    // kept for compat, use openCriticId

  // Review is per season for TV shows
  // seasonNumber stored on Review model

  reviews         Review[]
  listItems       ListItem[]

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([mediaType])
  @@index([title])
  @@index([normalizedTitle])
  @@index([releaseYear])
  @@index([verified])
}

model Person {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  imageUrl    String?
  bio         String?     @db.Text
  birthYear   Int?
  directed    MediaItem[] @relation("DirectedBy")
  appeared    MediaItem[] @relation("AppearedIn")
  authored    MediaItem[] @relation("AuthoredBy")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  @@index([name])
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  username        String    @unique
  displayName     String
  bio             String?
  avatarUrl       String?
  isVerified      Boolean   @default(false)
  isAdmin         Boolean   @default(false)
  passwordHash    String?
  googleId        String?   @unique
  googleEmail     String?
  defaultVisibility ReviewVisibility @default(PUBLIC)
  profilePublic   Boolean   @default(false)
  tasteThreshold  Int       @default(2)
  ignoredGenres   String[]  @default([])  // false = friends only, true = public
  // Emails (not usernames) — a username can now be changed by its owner
  // (see PATCH /api/users/me/settings), and a stored username would go
  // stale silently on rename since nothing here points back at a user id.
  excludedFriends String[]  @default([])  // emails excluded from friend rating filters
  consumedWithin  String?                 // e.g. "12m" or "2y" — default recency filter

  // Self-service account cancellation (soft — distinct from the admin
  // spam-purge hard delete). When set: login is blocked (passwordHash/googleId
  // are cleared at cancellation time), the profile page 404s, and all of this
  // user's reviews have reviewText/spoilerText cleared while rating/verdict
  // stay intact so aggregate scores don't shift. The User row itself and its
  // Review rows are kept — only the written content is removed.
  canceledAt      DateTime?
  reviews         Review[]
  reactions       Reaction[]
  comments        Comment[]
  friendsInitiated  Friendship[] @relation("FriendInitiator")
  friendsReceived   Friendship[] @relation("FriendReceiver")
  lists           MediaList[]
  notifications   Notification[]
  mediaRequests   MediaRequest[]
  refreshTokens   RefreshToken[]
  sentInvites     InviteToken[]    // invitations this user has sent
  sentMessages    Message[] @relation("MessageSender")
  receivedMessages Message[] @relation("MessageRecipient")
  sentListShares     ListShare[] @relation("ListShareSender")
  receivedListShares ListShare[] @relation("ListShareRecipient")
  emailVerificationTokens EmailVerificationToken[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@index([email])
  @@index([username])
}

// ─── EMAIL VERIFICATION TOKENS ─────────────────────────────────────────────
// Backs two flows: confirming a new registration's email (newEmail: null —
// the token just flips isVerified on the account it belongs to) and
// confirming an email-address change (newEmail set — clicking the link
// swaps User.email to newEmail). One-time use — consumed/deleted on click.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique @default(cuid())
  newEmail  String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([token])
  @@index([userId])
}

model RefreshToken {
  id          String   @id @default(cuid())
  token       String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model Friendship {
  id          String       @id @default(cuid())
  initiatorId String
  receiverId  String
  status      FriendStatus @default(PENDING)
  initiator   User @relation("FriendInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  receiver    User @relation("FriendReceiver",  fields: [receiverId],  references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([initiatorId, receiverId])
  @@index([receiverId])
  @@index([status])
}

model Review {
  id            String           @id @default(cuid())
  userId        String
  mediaItemId   String
  rating        Int
  dateConsumed  DateTime?        // When the user last read/watched/played this — optional
  seasonNumber  Int?             // TV shows only — null means overall series rating
  isRevisit     Boolean          @default(false)
  previousRating Int?
  reviewText    String?          @db.Text
  spoilerText   String?          @db.Text
  verdict       String?
  visibility    ReviewVisibility @default(PUBLIC)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaItem     MediaItem  @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  reactions     Reaction[]
  comments      Comment[]
  messages      Message[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  // Unique per user + media item + season (null season = overall)
  @@unique([userId, mediaItemId, seasonNumber])
  @@index([userId])
  @@index([mediaItemId])
  @@index([visibility])
  @@index([createdAt])
}

model Reaction {
  id        String   @id @default(cuid())
  userId    String
  reviewId  String
  emoji     String   @default("❤️")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, reviewId, emoji])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  reviewId  String
  body      String   @db.Text
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment? @relation("Replies", fields: [parentId], references: [id])
  replies   Comment[] @relation("Replies")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([reviewId])
}

model MediaList {
  id          String     @id @default(cuid())
  userId      String
  title       String
  description String?
  isPublic    Boolean    @default(true)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       ListItem[]
  shares      ListShare[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model ListItem {
  id          String    @id @default(cuid())
  listId      String
  mediaItemId String
  note        String?
  position    Int       @default(0)
  list        MediaList @relation(fields: [listId], references: [id], onDelete: Cascade)
  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id])
  addedAt     DateTime  @default(now())
  @@unique([listId, mediaItemId])
}

// A list actively sent to a specific friend ("Alex recommends this list to
// you") — distinct from MediaList.isPublic, which controls passive
// visibility (anyone vs. friends-only) rather than targeting one person.
// Sharing again with the same recipient is a no-op (@@unique below) rather
// than a duplicate notification.
model ListShare {
  id          String    @id @default(cuid())
  listId      String
  list        MediaList @relation(fields: [listId], references: [id], onDelete: Cascade)
  sharedById  String
  sharedBy    User      @relation("ListShareSender",    fields: [sharedById],  references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("ListShareRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  @@unique([listId, recipientId])
  @@index([recipientId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  payload   Json
  read      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId, read])
}

model MediaRequest {
  id               String    @id @default(cuid())
  userId           String
  title            String
  mediaType        MediaType
  directorOrAuthor String?
  notes            String?
  requestCount     Int       @default(1)
  flagged          Boolean   @default(false)
  flagNote         String?
  resolved         Boolean   @default(false)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  @@index([mediaType])
  @@index([requestCount])
  @@index([resolved])
}

model AdminSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─── INVITE TOKENS ────────────────────────────────────────────────────────
// Stores pending email invitations. When someone clicks the link in the email,
// we look up this token to know who invited them and auto-connect as friends.
model InviteToken {
  id          String   @id @default(cuid())
  
  // The user who sent the invite
  inviterId   String
  inviter     User     @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  
  // The email address this invite was sent to — null for a generic link
  // shared directly via text/Instagram/Facebook/etc. rather than emailed to
  // a specific address (see the "Share via..." button on friends.html)
  email       String?
  
  // Unique token embedded in the invite link — expires after 7 days
  token       String   @unique @default(cuid())
  
  // Whether this invite has been used (claimed) already
  claimed     Boolean  @default(false)
  
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  
  @@index([token])   // fast lookup when someone clicks the invite link
  @@index([email])   // check if an email already has a pending invite
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  body        String   @db.Text
  read        Boolean  @default(false)
  // Optional context — if sent in response to a review
  reviewId    String?
  review      Review?  @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  sender      User     @relation("MessageSender",    fields: [senderId],    references: [id], onDelete: Cascade)
  recipient   User     @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  @@index([recipientId, read])
  @@index([senderId])
  @@index([recipientId, senderId])
}

// Short codes for Share-a-Snapshot links (browse.html/profile.html) —
// POST /api/share-links mints one from a full path+query, GET
// /api/share-links/:code resolves it back. Exists purely so a shared link
// reads as a short code instead of the full filter state spelled out in
// the query string (type, several filter chips, reviewedBy, recency, etc.
// all at once can run long). No expiry — the underlying filtered view
// doesn't go stale the way e.g. an invite token would.
model ShareLink {
  code      String   @id
  path      String   @db.Text
  createdAt DateTime @default(now())
}
